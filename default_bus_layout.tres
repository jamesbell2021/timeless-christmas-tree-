[gd_resource type="AudioBusLayout" load_steps=5 format=3]

[sub_resource type="AudioEffectReverb" id="music_reverb"]
resource_name = "Reverb"
room_size = 0.55
damping = 0.6
dry = 0.9
wet = 0.22

[sub_resource type="AudioEffectReverb" id="sfx_reverb"]
resource_name = "Reverb"
room_size = 0.3
wet = 0.1

[sub_resource type="AudioEffectCompressor" id="master_glue"]
resource_name = "Compressor"
threshold = -14.0
ratio = 3.0
attack_us = 2000.0
release_ms = 220.0

[sub_resource type="AudioEffectHardLimiter" id="master_limit"]
resource_name = "HardLimiter"
ceiling_db = -1.0
release = 0.12

[resource]
bus/0/name = &"Master"
bus/0/solo = false
bus/0/mute = false
bus/0/bypass_fx = false
