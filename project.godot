; Engine configuration file.
; A Timeless Christmas Tree: An Edwardian Yuletide
; Godot 4.5 — GL Compatibility renderer so the same project exports to Web, Windows and Linux.

config_version=5

[application]

config/name="A Timeless Christmas Tree"
config/description="An Edwardian Yuletide. A cosy, stress-free tree-decorating sandbox with a short illustrated story."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.05, 0.04, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
Tex="*res://scripts/autoload/tex.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/dpi/allow_hidpi=false

[editor]

movie_writer/mjpeg_quality=0.95
movie_writer/mix_rate=48000

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.04, 0.03, 0.025, 1)
